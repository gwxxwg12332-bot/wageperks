    // 订阅官方 ModHook 事件：进存档 + 每天开门 都安排博士（比手动TryPatch OnNewDay可靠）
    private static void SubscribeModHooks()
    {
        try
        {
            ModHook.add_OnGameLoadedNormal(DelegateSupport.ConvertDelegate<Il2CppSystem.Action>(new System.Action(OnModGameLoaded)));
            ModHook.add_OnShutterOpenedEarly(DelegateSupport.ConvertDelegate<Il2CppSystem.Action>(new System.Action(OnModShutterOpened)));
            Log.Msg("[ModHook] 已订阅 OnGameLoadedNormal + OnShutterOpenedEarly（博士调度）");
        }
        catch (Exception ex)
        {
            Log.Msg("[ModHook] 订阅失败: " + ex.Message);
        }
    }

    // 进存档：安排博士（第1天必来）
    private static void OnModGameLoaded()
    {
        try
        {
            // 进档当天：强制治安检查 + 霉运（不依赖博士激活，内部判断特性）
            try { Patches.ForceInspectionToday(); } catch (Exception fex) { Log.Msg("[ModHook] OnGameLoaded强制检查失败: " + fex.Message); }
            try { Patches.ApplyBadLuck(); } catch (Exception bex) { Log.Msg("[ModHook] OnGameLoaded霉运失败: " + bex.Message); }

            if (DrJacksonFriendPerk.IsActive() && PlayerStore.Instance != null)
            {
                Patches.ScheduleJacksonToday();
            }

        }
        catch (Exception ex)
        {
            Log.Msg("[ModHook] OnGameLoaded安排博士失败: " + ex.Message);
        }
    }

    // 每天开门：安排博士（间隔7天）
    private static void OnModShutterOpened()
    {
        try
        {
            // 每天开门：成瘾警官事件调度（通用事件，总是发生）
            try { AddictOfficerEvent.OnNewDay(); } catch (Exception aex) { Log.Msg("[AddictOfficer] 调度失败: " + aex.Message); }

            // 每天开门：强制治安检查 + 霉运（可靠事件，OnNewDay手动patch不触发）
            try { Patches.ForceInspectionToday(); } catch (Exception fex) { Log.Msg("[ModHook] 开门强制检查失败: " + fex.Message); }
            try { Patches.ApplyBadLuck(); } catch (Exception bex) { Log.Msg("[ModHook] 开门霉运失败: " + bex.Message); }

            if (DrJacksonFriendPerk.IsActive() && PlayerStore.Instance != null)
            {
                // 诊断：开门时未来客户队列状态
                try
                {
                    var q = PlayerStore.Instance.futurStoreClientIdQueue;
                    string qs = q != null ? string.Join(",", q.ToArray()) : "null";
                    Log.Msg("[博士之友][诊断] 开门: futurQueue(" + (q != null ? q.Count : -1) + ")=[" + qs + "]");
                } catch { }
                Patches.ScheduleJacksonToday();
            }
        }
        catch (Exception ex)
        {
            Log.Msg("[ModHook] OnShutterOpened安排博士失败: " + ex.Message);
        }
    }

    private static void ApplyAllPatches()
    {
        try
