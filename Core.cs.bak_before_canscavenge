            // 3.7 内容解锁客户补丁（参考XIAOWO：官方蓝图方式调度特殊NPC，每天来）
            ManualPatcher.TryPatch(typeof(StoreClientManager), "HandleContentUnlockClient",
                postfix: nameof(Patches.PostfixOnHandleContentUnlockClient));

            // 3.8 客户到达补丁（补丁触发对话+随机商品，不用OnUpdate轮询）
            // 注意：用 StoreUIManager.OnNextClientArrived（v5.3.1验证过的对话入口），
