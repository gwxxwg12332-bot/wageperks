                postfix: nameof(Patches.PostfixOnAddClient),
                parameterTypes: new Type[] { typeof(StoreClient) });

            // 3.6 博士来访：改用 QueueFuturClient 通道（OnNewDay/LoadGame 每天安排 inventorStorage），
