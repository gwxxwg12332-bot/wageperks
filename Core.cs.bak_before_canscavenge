            // 2.1 蛙哥妙妙箱：Patch NewGameData.HandleInitialItem（与拾荒者信物同一原生开局物品机制，
            //     只在开新档调用，读档不触发，从根本解决多刷/补发）
            ManualPatcher.TryPatch(typeof(NewGameData), "HandleInitialItem",
                postfix: nameof(Patches.HandleInitialItemPostfix));

            // 3. 新的一天补丁（用StoreClientManager.OnNewDay）
            ManualPatcher.TryPatch(typeof(StoreClientManager), "OnNewDay",
                postfix: nameof(Patches.PostfixOnNewDay));
            // 3.55 进存档第一天补丁（开新档第一天就排博士，不依赖OnNewDay/NewGame）
            ManualPatcher.TryPatch(typeof(PlayerStore), "BeginDay",
                postfix: nameof(Patches.PostfixOnBeginDay));
            // 3.5 客户添加补丁（关键修复：博士/退休枪匠/水商/酒商特殊NPC都依赖AddClient事件触发）
