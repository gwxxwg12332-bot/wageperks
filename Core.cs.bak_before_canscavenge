    }

    public static void LogMsg(string msg)
    {
        // 【发布版静默】DebugMode=false 时所有 Core.LogMsg 诊断日志不输出，
        // 避免发布版刷诊断日志。开发版（DebugMode=true）保留全部日志。
        if (!DebugMode) return;
        Log?.Msg(msg);
