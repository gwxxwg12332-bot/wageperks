            ManualPatcher.TryPatch(typeof(StartOfDayUIManager), "OnStartDayButtonClicked",
                postfix: nameof(Patches.PostfixStartOfDayButtonClicked));

            // 诊断类 Patch 集中（仅开发版，发布版不注册）
            Diagnostics.ApplyPatches();

            // 自定义sprite拦截（紧凑型储物箱）
